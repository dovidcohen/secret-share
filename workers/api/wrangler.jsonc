{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Publish to the custom domain only; no workers.dev subdomain needed.
  "workers_dev": false,
  "routes": [
    { "pattern": "shareasecret.io", "custom_domain": true },
    { "pattern": "www.shareasecret.io", "custom_domain": true },
    // White-label tenant subdomains (needs the proxied `*` CNAME in DNS).
    { "pattern": "*.shareasecret.io/*", "zone_name": "shareasecret.io" },
    // Cloudflare-for-SaaS custom hostnames — one route per vanity domain.
    // NOTE: the route can only be created AFTER the custom hostname exists in
    // the zone (wrangler rejects it otherwise); add per tenant, post-creation.
    { "pattern": "secrets.fordmed.com/*", "zone_name": "shareasecret.io" }
  ],
  // run_worker_first: true so the Worker can stamp security headers on every
  // asset response, not just API routes.
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "CREATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "TURN_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "MailboxDO" },
      { "name": "USAGE", "class_name": "UsageDO" }
    ]
  },
  // Tenant registry (white-label SaaS): host:<hostname>, tenant:<id>,
  // logo:<id>, plus cached OIDC discovery/JWKS documents.
  "kv_namespaces": [{ "binding": "TENANTS", "id": "aa9ecd5b4bf84ae6aa6b13b1df939573" }],
  // Usage alert: check request volume against the free-tier daily cap.
  "triggers": { "crons": ["7 */6 * * *", "0 13 * * *"] },
  // No destination_address here: it can send to any verified Email Routing
  // destination, and the recipient (ALERT_TO) is a secret, not public config.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  "vars": {
    "CF_ACCOUNT_ID": "b1c0bee581e5bd9e6b843bfb9cd1c587",
    "USAGE_ALERT_THRESHOLD": "80000",
    "ALERT_FROM": "alerts@shareasecret.io"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailboxDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UsageDO"] }
  ],
  "observability": { "enabled": true }
}
