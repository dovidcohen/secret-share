{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Publish to the custom domain only; no workers.dev subdomain needed.
  "workers_dev": false,
  "routes": [
    { "pattern": "shareasecret.io", "custom_domain": true },
    { "pattern": "www.shareasecret.io", "custom_domain": true }
  ],
  // run_worker_first: true so the Worker can stamp security headers on every
  // asset response, not just API routes.
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "CREATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "TURN_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "MailboxDO" }]
  },
  // Usage alert: check request volume against the free-tier daily cap.
  "triggers": { "crons": ["*/5 * * * *"] },
  "send_email": [{ "name": "ALERT_EMAIL", "destination_address": "dovidcohen1@gmail.com" }],
  "vars": {
    "CF_ACCOUNT_ID": "b1c0bee581e5bd9e6b843bfb9cd1c587",
    "USAGE_ALERT_THRESHOLD": "1",
    "ALERT_FROM": "alerts@shareasecret.io",
    "ALERT_TO": "dovidcohen1@gmail.com"
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxDO"] }],
  "observability": { "enabled": true }
}
