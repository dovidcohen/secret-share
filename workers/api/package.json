    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@secret-share/protocol": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
