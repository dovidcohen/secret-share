{
  "name": "shareasecret",
  "version": "0.2.0",
  "description": "Share a small secret with exactly one person. End-to-end encrypted, read-once, auto-expiring — shareasecret.io from the terminal.",
  "license": "SEE LICENSE IN README.md",
  "homepage": "https://shareasecret.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dovidcohen/secret-share.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "secrets",
    "secret-sharing",
    "one-time",
    "read-once",
    "encryption",
    "end-to-end",
    "password",
    "cli"
  ],
  "type": "module",
  "bin": {
    "shareasecret": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.cjs \"--banner:js=#!/usr/bin/env node\"",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@secret-share/crypto": "workspace:*",
    "@secret-share/protocol": "workspace:*",
    "@types/node": "^26.0.0",
    "esbuild": "^0.25.0",
    "vitest": "^3.2.0"
  }
}
